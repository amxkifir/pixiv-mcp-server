# [核心] Pixiv API 认证令牌 (必须)
PIXIV_REFRESH_TOKEN=bi_XsI_iXOKE1tWH_Ma25YZ5wDc_sINGW5uKyFuLjTs

# [功能] 文件下载路径 (可选, 默认为 './downloads')
DOWNLOAD_PATH=./downloads

# [功能] 文件命名模板 (可选, 默认: '{author} - {title}_{id}')
FILENAME_TEMPLATE={author} - {title}_{id}

# [功能] 下载子目录模板 (可选, 留空使用扁平结构)
# 可用变量: {author}, {type}, {tag}, {id}, {title}
DOWNLOAD_PATH_TEMPLATE={type}/{author}

# [网络] 代理服务器设置 (可选, 默认禁用)
# https_proxy=http://127.0.0.1:7890
